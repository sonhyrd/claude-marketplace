{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-native.sh",
    "padding": 0
  },
  "skillOverrides": {
    "code-review": "off",
    "cypress-debugger": "off",
    "git-guardrails-claude-code": "off",
    "loop-me": "off",
    "migrate-to-shoehorn": "off",
    "obsidian-vault": "off",
    "playwright-cli": "off",
    "playwright-debugger": "off",
    "scaffold-exercises": "off",
    "setup-pre-commit": "off",
    "visualize-repo": "off",
    "wizard": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-shape": "off",
    "batch-grill-me": "off",
    "claude-handoff": "off",
    "edit-article": "off",
    "setup-ts-deep-modules": "off",
    "to-questionnaire": "off",
    "chrome-auth-recorder": "off",
    "make-interfaces-feel-better": "off",
    "setup-cursor-worker": "off",
    "triage": "off",
    "tdd": "off",
    "fixing-accessibility": "off",
    "prototype": "user-invocable-only",
    "review": "off",
    "update-config": "user-invocable-only",
    "schedule": "user-invocable-only",
    "run": "user-invocable-only",
    "loop": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "security-review": "user-invocable-only",
    "init": "user-invocable-only",
    "computer-use": "user-invocable-only",
    "improve": "user-invocable-only",
    "improve-ui": "user-invocable-only",
    "codebase-design": "user-invocable-only",
    "research": "user-invocable-only",
    "domain-modeling": "user-invocable-only",
    "visual-plan": "user-invocable-only",
    "hotfix-draft-release": "user-invocable-only"
  },
  "permissions": {
    "deny": [
      "ScheduleWakeup",
      "ReportFindings"
    ],
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  }
}
