#!/usr/bin/env bash
# pre-push: refresh the local e2e-skills install so it matches HEAD being pushed.
# Delegates to scripts/dev/reinstall-skills.sh, which runs:
#   `skills remove` (no-op if not installed) + `skills add --copy` (idempotent).
# This handles both initial install (first push) and refresh (subsequent pushes).
# Wired in by scripts/dev/install-hooks.sh (sets core.hooksPath=scripts/hooks).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "==> pre-push: README i18n parity guard"
en_sec=$(grep -c '^## ' "$REPO_ROOT/README.md" || true)
en_fence=$(grep -c '^```' "$REPO_ROOT/README.md" || true)
for f in README.ko.md README.ja.md README.zh-cn.md; do
  s=$(grep -c '^## ' "$REPO_ROOT/$f" 2>/dev/null || true)
  c=$(grep -c '^```' "$REPO_ROOT/$f" 2>/dev/null || true)
  if [ "${s:-0}" != "$en_sec" ] || [ "${c:-0}" != "$en_fence" ]; then
    echo "pre-push: README i18n parity failed for $f (sections ${s:-0} vs $en_sec, fences ${c:-0} vs $en_fence)." >&2
    echo "pre-push: translations drifted from README.md — sync them before pushing." >&2
    exit 1
  fi
done

echo "==> pre-push: running local security/manifest gate"
"$REPO_ROOT/scripts/ci/pre-push-security.sh" --quiet
echo "==> pre-push: refreshing local e2e-skills install"
"$REPO_ROOT/scripts/dev/reinstall-skills.sh"
