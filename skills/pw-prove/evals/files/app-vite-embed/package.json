{
  "name": "app-vite-embed",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "b:sdk": "vite build -c vite.config.sdk.ts -w",
    "b:app": "vite build -c vite.config.app.ts -w --base /chat",
    "dev": "pnpm b:sdk & vite -c vite.config.app.ts --port 5173",
    "build:staging": "tsx ./script/build.staging.ts",
    "serve": "pnpm run serve:start-ssr",
    "serve:start-ssr": "PORT=4100 node ./script/serve-ssr.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": { "@playwright/test": "1.62.1", "vite": "5.4.0", "vue": "3.5.0" }
}
